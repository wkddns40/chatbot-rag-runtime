# Generate unique LOCAL credentials with: python setup.py
POSTGRES_PASSWORD=
ADMIN_TOKEN=
READER_TOKEN=
# Leave blank for explicitly labelled CPU evidence-demo mode.
# For a model on the Docker host: http://host.docker.internal:8000/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash
# Optional OpenAI-compatible embeddings endpoint; otherwise lexical hash vectors.
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_DIM=384
